{
  "name": "solicitation-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browse, search and filter daily DLA DIBBS RFQ solicitations",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "fetch": "node server/ingest/run.js",
    "test": "node --test server/**/*.test.js"
  },
  "engines": { "node": ">=22.5" },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.0",
    "vite": "^6.0.0"
  }
}
